  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/alignTokens.test.mjs tests/mockSentences.test.mjs tests/formatLocalTime.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
