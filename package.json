{
  "name": "ielts-dictation",
  "version": "1.0.0",
  "description": "Self-hosted IELTS transcript recognition, TTS generation, dictation practice, and vocabulary app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cjy15530612552-sudo/ielts-dictation.git"
  },
